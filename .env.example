# Copia este archivo como .env.local

# Claude (botón "Armar modelo con IA") — console.anthropic.com
ANTHROPIC_API_KEY=

# Correo SMTP para alertas de reabastecimiento y reportes del cronómetro
# Ejemplo con Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 y una "contraseña de aplicación"
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="CORPOTEX <alertas@corpotex.pe>"
